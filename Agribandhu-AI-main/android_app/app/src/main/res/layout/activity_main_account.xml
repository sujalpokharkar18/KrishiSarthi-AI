<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/green_backgroung"
    tools:context=".Main_Account">

    <!-- Toolbar -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/green"
        android:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar"
        android:elevation="4dp"
        app:menu="@menu/account_toolbar"
        app:title="Farmer Dashboard"
        app:titleTextColor="@android:color/white"
        app:navigationIcon="@drawable/backarrow" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Profile & Farm Details Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp"
                android:background="@drawable/profile_bg"
                android:elevation="6dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="16dp"
                android:clipToOutline="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageView
                        android:id="@+id/profileImage"
                        android:layout_width="70dp"
                        android:layout_height="70dp"
                        android:background="@drawable/circle_bg"
                        android:clipToOutline="true"
                        android:scaleType="centerCrop"
                        android:src="@drawable/farmer" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="14dp">

                        <TextView
                            android:id="@+id/farmerName"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Farmer Name"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:textColor="#222" />

                        <TextView
                            android:id="@+id/farmerLocation"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="📍 Location not set"
                            android:textColor="#555"
                            android:textSize="14sp"
                            android:layout_marginTop="2dp" />

                        <TextView
                            android:id="@+id/farmerEmailText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="✉️ user@example.com"
                            android:textColor="#777"
                            android:textSize="12sp"
                            android:layout_marginTop="2dp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Divider -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#20000000"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="10dp" />

                <!-- Farm Details Row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:baselineAligned="false">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Farm Land Size"
                            android:textSize="11sp"
                            android:textColor="#666" />

                        <TextView
                            android:id="@+id/farmSize"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🌾 5 Acres"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="#2E7D32" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Monthly Income"
                            android:textSize="11sp"
                            android:textColor="#666" />

                        <TextView
                            android:id="@+id/farmIncome"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="💰 ₹25,000/mo"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="#2E7D32" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Buttons: Edit Profile and Switch/Logout -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="12dp">

                    <Button
                        android:id="@+id/btnEditProfile"
                        android:layout_width="0dp"
                        android:layout_height="38dp"
                        android:layout_weight="1"
                        android:text="✏️ Edit Profile"
                        android:textSize="12sp"
                        android:backgroundTint="#4CAF50"
                        android:textColor="@android:color/white"
                        android:layout_marginEnd="6dp"
                        android:padding="0dp" />

                    <Button
                        android:id="@+id/btnLogout"
                        android:layout_width="0dp"
                        android:layout_height="38dp"
                        android:layout_weight="1"
                        android:text="🚪 Switch Account"
                        android:textSize="12sp"
                        android:backgroundTint="#E53935"
                        android:textColor="@android:color/white"
                        android:layout_marginStart="6dp"
                        android:padding="0dp" />
                </LinearLayout>

            </LinearLayout>

            <!-- Quick AI Assistant Buttons -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:id="@+id/aiCropButton"
                    android:layout_width="0dp"
                    android:layout_height="90dp"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="@drawable/circle_ai_bg"
                    android:layout_marginEnd="8dp">

                    <ImageView
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:src="@drawable/ai" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="AI Advisory"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="#fff"
                        android:layout_marginTop="4dp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/aiFertilizerButton"
                    android:layout_width="0dp"
                    android:layout_height="90dp"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="@drawable/circle_ai_bg"
                    android:layout_marginStart="8dp">

                    <ImageView
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:src="@drawable/ai_timetable" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="AI Timetable"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="#fff"
                        android:layout_marginTop="4dp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Crops Tracking Section Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">

                <TextView
                    android:id="@+id/txtCropsHeader"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="🌾 Active Crops on Your Farm"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#333" />

                <TextView
                    android:id="@+id/txtTotalCropsCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0 Crops"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="#2E7D32"
                    android:background="#C8E6C9"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:paddingTop="3dp"
                    android:paddingBottom="3dp" />
            </LinearLayout>

            <!-- Empty State for Crops -->
            <LinearLayout
                android:id="@+id/emptyCropsView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/card_bg"
                android:padding="16dp"
                android:gravity="center"
                android:visibility="gone"
                android:layout_marginBottom="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🌱 No crops tracked yet!"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="#444" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Use 'AI Timetable' to create a 7-day weather-smart plan and track daily tasks."
                    android:textSize="12sp"
                    android:textColor="#666"
                    android:gravity="center"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="10dp" />

                <Button
                    android:id="@+id/btnPlanFirstCrop"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:text="+ Plan a Crop Now"
                    android:textSize="12sp"
                    android:backgroundTint="@color/green"
                    android:textColor="@android:color/white"
                    android:padding="0dp" />
            </LinearLayout>

            <!-- Horizontal Scroll of Tracked Crops -->
            <HorizontalScrollView
                android:id="@+id/cropScrollView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none"
                android:paddingBottom="8dp">

                <LinearLayout
                    android:id="@+id/cropContainer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />

            </HorizontalScrollView>

        </LinearLayout>
    </ScrollView>
</LinearLayout>
